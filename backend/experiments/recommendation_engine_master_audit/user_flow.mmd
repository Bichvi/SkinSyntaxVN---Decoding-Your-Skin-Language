    %% User Flow and Context Routing Diagram for SkinSyntaxVN

    Start([Người dùng truy cập index.php?r=home]) --> CheckSignals{Kiểm tra tín hiệu người dùng}

    %% Production Branches
    CheckSignals -- "Không có tín hiệu (Khách mới)" --> ModeSimple[Chế độ SIMPLE<br/>Simple Recommender: IMDb Weighted Rating]
    CheckSignals -- "Chỉ có hành vi phiên (View / Cart / Search)" --> ModeBehavior[Chế độ BEHAVIOR_CONTENT<br/>Multi-Signal Behavior Fusion + TF-IDF]
    CheckSignals -- "Chỉ có lịch sử mua hàng" --> ModePurchase[Chế độ PURCHASE_CONTENT<br/>Purchase History Time-Decay + TF-IDF]
    CheckSignals -- "Chỉ có hồ sơ khảo sát da" --> ModeProfile[Chế độ PROFILE_CONTENT<br/>Profile Term Vector + Skin Compatibility]
    CheckSignals -- "Có cả hồ sơ da & hành vi phiên" --> ModeHybrid[Chế độ ADAPTIVE_HYBRID<br/>Hybrid Query 0.50 Behavior + 0.50 Profile]
    CheckSignals -- "Hồ sơ da không sinh được vector" --> ModePartial[Chế độ PARTIAL_PROFILE_FALLBACK<br/>Fallback theo hành vi hoặc ngân sách]

    %% Common Production Processing Pipeline
    ModeBehavior --> CombineScore[Tính toán Cosine Similarity & Tái xếp hạng FinalScore]
    ModePurchase --> CombineScore
    ModeProfile --> CombineScore
    ModeHybrid --> CombineScore
    ModePartial --> CombineScore

    CombineScore --> FilterDeduplicate[Bộ lọc tương tác:<br/>Loại bỏ sản phẩm vừa xem & sản phẩm trong giỏ]
    FilterDeduplicate --> FamilyDiversity[Bộ lọc đa dạng hóa:<br/>Tối đa 1 sản phẩm đại diện cho mỗi dòng biến thể]
    FamilyDiversity --> ReasonTags[Gắn nhãn giải thích minh bạch:<br/>Reason Tags khớp với tín hiệu đóng góp]
    ReasonTags --> DisplaySection3[Hiển thị Section 3: Dành Riêng Cho Bạn<br/>Tiêu đề và thông điệp thích ứng theo dominant_signal]

    ModeSimple --> DisplaySection55[Hiển thị Section 5.5: Được Yêu Thích Nhất<br/>Bảng xếp hạng Top-4 Weighted Rating]
    DisplaySection3 --> End([Giao diện trang chủ hoàn tất])
    DisplaySection55 --> End

