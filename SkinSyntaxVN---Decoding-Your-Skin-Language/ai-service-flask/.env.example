# LlamaIndex Configuration
# Lưu file này tại: project-root/ai-service-flask/.env

# OpenAI API Key (cho LlamaIndex)
OPENAI_API_KEY=sk-your-api-key-here

# LlamaIndex Settings
LLAMA_INDEX_MODE=local  # local hoặc cloud
LLAMA_INDEX_MODEL=gpt-3.5-turbo  # gpt-3.5-turbo, gpt-4, v.v.

# Vector Store Settings (Chroma, Pinecone, v.v.)
VECTOR_DB_TYPE=chroma  # chroma hoặc pinecone
VECTOR_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=skinsyntax_products

# RAG Settings
CHUNK_SIZE=1024
CHUNK_OVERLAP=20
TOP_K=3

# Recommendation Settings
RECOMMENDATION_MODEL=gpt-3.5-turbo
TEMPERATURE=0.7

# Flask Settings
FLASK_ENV=development
FLASK_PORT=5000
