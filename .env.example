# SkinSyntaxVN — .env template (repo also tracks .env for solo dev)
# Machine-specific overrides: use .env.local (gitignored)

# --- App ---
APP_URL=http://localhost
FRONTEND_ROOT=
BACKEND_ROOT=
SOCIAL_LOCAL_FALLBACK=0

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=skinsyntax

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL=604800
SESSION_CACHE_TTL=3600

# --- AI service (OpenAI — required) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODELS=gpt-4o-mini,gpt-4o
TAVILY_API_KEY=

# --- AI service (Flask / Gunicorn) ---
CHATBOT_PORT=5001
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=gevent

# --- AI endpoints (PHP BFF → Flask) ---
# Docker: use http://ai-service:5001/...
# Local:  use http://127.0.0.1:5001/...
AI_CHAT_ENDPOINT=http://127.0.0.1:5001/api/chat/auto
AI_CHAT_STREAM_ENDPOINT=http://127.0.0.1:5001/api/chat/stream
AI_RECOMMENDATION_ENDPOINT=http://127.0.0.1:5001/api/recommend/explain
AI_HYBRID_RECOMMENDATION_ENDPOINT=http://127.0.0.1:5001/api/recommend/langchain-rag
AI_CHAT_TIMEOUT=60
AI_RECOMMENDATION_TIMEOUT=20
AI_HYBRID_RECOMMENDATION_TIMEOUT=30

# --- Vector DB & data paths ---
CHROMA_DB_PATH=./database/chroma_db
CSV_FILE_PATH=./database/data_clean_final.csv

# --- Mail / OTP ---
MAIL_DEMO_MODE=1
MAIL_FROM_ADDRESS=no-reply@skinsyntax.local
MAIL_FROM_NAME=SkinSyntax
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/index.php?r=auth_social_callback

# --- Facebook OAuth ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost/index.php?r=auth_social_callback

# --- Bank transfer (MB / QR) ---
BANK_TRANSFER_BANK_ID=970422
BANK_TRANSFER_BANK_NAME=MB Bank
BANK_TRANSFER_ACCOUNT_NO=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_QR_TEMPLATE=compact2
BANK_TRANSFER_WEBHOOK_SECRET=

# --- SePay ---
SEPAY_API_TOKEN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_POLLING_ENABLED=false

# --- Optional legacy LLM keys (not used by current llm_pool.py) ---
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=
# GOOGLE_API_KEYS=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ZHIPU_API_KEY=
# HUGGINGFACE_API_KEY=
