# SkinSyntaxVN — .env template (repo also tracks .env for solo dev)
# Machine-specific overrides: use .env.local (gitignored)

# --- App ---
APP_URL=http://localhost
FRONTEND_ROOT=
BACKEND_ROOT=
SOCIAL_LOCAL_FALLBACK=0

# --- MongoDB ---
# MongoDB Atlas (production/staging) — điền credentials vào .env thực, KHÔNG commit .env
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@skinsyntaxvn-db.3edac4m.mongodb.net/?appName=SkinSyntaxVN-DB
MONGO_DB=skinsyntax
MONGO_DB_NAME=skinsyntax
# --- Local development fallback ---
# MONGO_URI=mongodb://127.0.0.1:27017

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL=604800
SESSION_CACHE_TTL=3600

# --- AI service (OpenAI — required) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MODELS=gpt-4o-mini,gpt-4o
TAVILY_API_KEY=

# --- AI service (Flask / Gunicorn) ---
CHATBOT_PORT=5001
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=gevent

# --- AI endpoints (PHP BFF → Flask) ---
# Docker: use http://ai-service:5001/...
# Local:  use http://127.0.0.1:5001/...
AI_CHAT_ENDPOINT=http://127.0.0.1:5001/api/chat/auto
AI_CHAT_STREAM_ENDPOINT=http://127.0.0.1:5001/api/chat/stream
AI_RECOMMENDATION_ENDPOINT=http://127.0.0.1:5001/api/recommend/explain
AI_HYBRID_RECOMMENDATION_ENDPOINT=http://127.0.0.1:5001/api/recommend/langchain-rag
AI_LLAMA_INDEX_RECOMMENDATION_ENDPOINT=http://127.0.0.1:5001/api/recommend/profile
# Trang goiy dùng engine PHP; 1 = chờ thêm AI RAG khi tải trang (~10s, có cache session)
AI_GOIY_SYNC_AI=0
AI_CHAT_TIMEOUT=60
AI_RECOMMENDATION_TIMEOUT=20
AI_HYBRID_RECOMMENDATION_TIMEOUT=30

# --- Vector DB & data paths ---
CHROMA_DB_PATH=./database/chroma_db
CSV_FILE_PATH=./database/data_clean_final.csv

# --- Mail / OTP ---
MAIL_DEMO_MODE=1
MAIL_FROM_ADDRESS=no-reply@skinsyntax.local
MAIL_FROM_NAME=SkinSyntax
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/index.php?r=auth_social_callback

# --- Facebook OAuth ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost/index.php?r=auth_social_callback

# --- Bank transfer (MB / QR) ---
BANK_TRANSFER_BANK_ID=970422
BANK_TRANSFER_BANK_NAME=MB Bank
BANK_TRANSFER_ACCOUNT_NO=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_QR_TEMPLATE=compact2
BANK_TRANSFER_WEBHOOK_SECRET=

# --- SePay ---
SEPAY_API_TOKEN=
SEPAY_ACCOUNT_NUMBER=
SEPAY_POLLING_ENABLED=false

# --- VNPAY Sandbox Gateway ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=


# --- Optional legacy LLM keys (not used by current llm_pool.py) ---
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=
# GOOGLE_API_KEYS=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# ZHIPU_API_KEY=
# HUGGINGFACE_API_KEY=

# --- VieNeu-TTS Voice Service ---
TTS_PORT=5002
TTS_SERVICE_URL=http://127.0.0.1:5002/api/tts/stream
NUM_THREADS=4
PRECISION=int8

# --- LiveKit Cloud / Voice Co-Host ---
LIVEKIT_URL=wss://your-livekit-domain.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret
COOLDOWN_SECONDS=3.0
MAX_QUEUE_SIZE=5

# --- AI Idol Agent (isolated from chatbot/recommendation/voice chat) ---
AI_IDOL_ENDPOINT=http://127.0.0.1:5003
AI_IDOL_AGENT_ENABLED=true
# Keep external unattended publishing locked until the Agent evaluation suite passes.
AI_IDOL_AGENT_ALLOW_AUTO_PUBLISH=false
AI_IDOL_SCRIPT_COUNCIL_ENABLED=true
AI_IDOL_SCRIPT_COUNCIL_URL=http://ai-idol-agent-service:5013
AI_IDOL_SCRIPT_COUNCIL_TIMEOUT=240

# --- AI Idol product videos on Cloudflare R2 (leave empty to keep videos off product pages) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base for video/poster URLs, e.g. https://pub-xxxx.r2.dev (later: your own domain).
R2_PUBLIC_BASE_URL=
AI_IDOL_CREW_REVIEW_MODEL=openai/gpt-oss-20b
AI_IDOL_CREW_MAX_TOKENS=650
AI_IDOL_CREW_MAX_RPM=4
AI_IDOL_INTERNAL_TOKEN=
GROQ_API_KEY=
AI_IDOL_GROQ_MODEL=openai/gpt-oss-20b
AI_IDOL_GROQ_FALLBACK_MODELS=qwen/qwen3.8-27b

# Product metrics snapshots (AI Idol). Chi dat TRACKING_STARTED_ON sau khi deploy tracking, bang ngay KE TIEP ngay deploy (YYYY-MM-DD).
AI_IDOL_TRACKING_STARTED_ON=
AI_IDOL_PRODUCT_EVENTS_RETENTION_DAYS=120
# Final audio: voice loudness target + ducked background music from ai-idol-service/assets/music
AI_IDOL_AUDIO_MIX_ENABLED=true
AI_IDOL_AUDIO_TARGET_LUFS=-14
AI_IDOL_MUSIC_BED_LUFS=-19
# Ducking ratio while Syna speaks (higher = music drops more under her voice)
AI_IDOL_MUSIC_DUCK_RATIO=3
# Seconds of music before the first / after the last word; "2-3" picks a value per video
AI_IDOL_MUSIC_INTRO_SECONDS=2-3
AI_IDOL_MUSIC_OUTRO_SECONDS=2-3
# Intro/outro cards (product photo, name, price, "Đặt hàng ngay") shown during the music lead-in/tail
AI_IDOL_TITLE_CARDS_ENABLED=true
# Natural pauses: Piper silence after each sentence + varied pause between script sections (seconds)
AI_IDOL_PIPER_SENTENCE_SILENCE=0.2
AI_IDOL_SECTION_PAUSE_MIN=0.35
AI_IDOL_SECTION_PAUSE_MAX=0.8
# Chế độ Tự động của AI Idol Studio: số sản phẩm mặc định khi prompt không nêu, mức tối đa, và các giờ vàng phát (HH:MM, cách nhau bằng dấu phẩy; giờ Việt Nam)
AI_IDOL_AUTOPILOT_DEFAULT_PRODUCTS=5
AI_IDOL_AUTOPILOT_MAX_PRODUCTS=10
AI_IDOL_AUTOPILOT_SLOTS=12:00,20:00
# Dat false trong moi truong test de PHP khong ghi product_events.
PRODUCT_EVENTS_ENABLED=true

# --- Aiven Valkey Cache ---
CACHE_DRIVER=valkey
VALKEY_URL=rediss://default:YOUR_PASSWORD@your-valkey-host.aivencloud.com:PORT
CACHE_PREFIX=skinsyntax:
CACHE_DEFAULT_TTL=300
