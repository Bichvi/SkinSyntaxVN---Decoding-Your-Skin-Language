# LlamaIndex Configuration
# Lưu file này tại: project-root/ai-service-flask/.env

# Gemini API Keys
# Nếu có nhiều key hoặc nhiều project, dán theo dạng key1,key2,key3
GOOGLE_API_KEYS=AIza-your-primary-key,AIza-your-secondary-key
# Tương thích ngược: nếu chỉ có 1 key, bạn vẫn có thể dùng biến cũ
GOOGLE_API_KEY=

# LlamaIndex Settings
LLAMA_INDEX_MODE=local  # local hoặc cloud
LLAMA_INDEX_MODEL=models/gemini-2.5-flash

# Vector Store Settings (Chroma, Pinecone, v.v.)
VECTOR_DB_TYPE=chroma  # chroma hoặc pinecone
VECTOR_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=skinsyntax_products

# RAG Settings
CHUNK_SIZE=1024
CHUNK_OVERLAP=20
TOP_K=3

# Recommendation Settings
RECOMMENDATION_MODEL=gemini-2.5-flash
TEMPERATURE=0.4
RECOMMENDATION_MAX_PRODUCTS=5

# Chat response cache in Flask service
CHAT_CACHE_TTL_SECONDS=604800

# Flask Settings
FLASK_ENV=development
FLASK_PORT=5000
