{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HomeRecommendResponse",
  "type": "object",
  "required": ["degraded", "took_ms", "sections"],
  "properties": {
    "degraded": {"type": "boolean"},
    "took_ms": {"type": "integer", "minimum": 0},
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "items"],
        "properties": {
          "key": {"enum": ["seen", "skin", "concern"]},
          "seed": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {"id": {"type": "string"}, "name": {"type": "string"}}
          },
          "skin_type": {
            "type": "object",
            "required": ["key", "name"],
            "properties": {"key": {"type": "string"}, "name": {"type": "string"}}
          },
          "concern": {
            "type": "object",
            "required": ["key", "name"],
            "properties": {"key": {"type": "string"}, "name": {"type": "string"}}
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["product_id", "reason"],
              "properties": {
                "product_id": {"type": "string", "pattern": "^[0-9]{1,12}$"},
                "reason": {
                  "type": "object",
                  "required": ["code"],
                  "properties": {
                    "code": {"enum": ["seen_shared_ingredient", "seen_same_category", "skin_fit", "concern_ingredient", "concern_target"]}
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  }
}
